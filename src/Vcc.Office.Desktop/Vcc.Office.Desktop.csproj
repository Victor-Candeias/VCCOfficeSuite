<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>VCC Office Suite</AssemblyName>
    <ApplicationIcon>Assets/VccOfficeSuite.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.6" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.6" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.6" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Assets/VccOfficeSuite.ico" LogicalName="Vcc.Office.Desktop.AppIcon" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Vcc.Office.CoreShell/Vcc.Office.CoreShell.csproj" />
    <ProjectReference Include="../Vcc.Office.PluginHost/Vcc.Office.PluginHost.csproj" />
    <!-- Compile the Writer, but do not reference its assembly from the executable. -->
    <ProjectReference Include="../Vcc.Office.Writer/Vcc.Office.Writer.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <Target Name="StageWriterPluginForBuild" AfterTargets="Build" Condition="'$(DesignTimeBuild)' != 'true'">
    <MakeDir Directories="$(TargetDir)Plugins/Writer" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)/../Vcc.Office.Writer/bin/$(Configuration)/net10.0/Vcc.Office.Writer.dll" DestinationFolder="$(TargetDir)Plugins/Writer" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)/../Vcc.Office.Writer/plugin.json" DestinationFolder="$(TargetDir)Plugins/Writer" />
  </Target>
  <Target Name="StageWriterPluginForPublish" AfterTargets="Publish">
    <MakeDir Directories="$(PublishDir)Plugins/Writer" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)/../Vcc.Office.Writer/bin/$(Configuration)/net10.0/Vcc.Office.Writer.dll" DestinationFolder="$(PublishDir)Plugins/Writer" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)/../Vcc.Office.Writer/plugin.json" DestinationFolder="$(PublishDir)Plugins/Writer" />
  </Target>
</Project>
