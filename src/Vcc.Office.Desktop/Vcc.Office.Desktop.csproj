<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>VCC Office Suite</AssemblyName>
    <ApplicationIcon>../Vcc.Office.Shell/Assets/VccOfficeSuite.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.6" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.6" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.6" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="../Vcc.Office.Shell/Assets/VccOfficeSuite.ico" LogicalName="Vcc.Office.Desktop.AppIcon" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Vcc.Office.CoreShell/Vcc.Office.CoreShell.csproj" />
  </ItemGroup>
</Project>
