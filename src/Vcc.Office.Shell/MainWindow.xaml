<Window x:Class="Vcc.Office.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="VCC Office" Width="1600" Height="940" MinWidth="1024" MinHeight="700"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="#FAFBFD" Foreground="#172238" FontFamily="Segoe UI" FontSize="14"
        UseLayoutRounding="True" SnapsToDevicePixels="True" Language="pt-PT"
        PreviewKeyDown="Window_PreviewKeyDown" AutomationProperties.Name="VCC Office — Início">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="64" ResizeBorderThickness="8" CornerRadius="0" GlassFrameThickness="0"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <SolidColorBrush x:Key="HomeAccent" Color="#145ED9"/>
        <SolidColorBrush x:Key="HomeMuted" Color="#647087"/>
        <SolidColorBrush x:Key="HomeLine" Color="#E2E7EF"/>
        <Geometry x:Key="SearchIcon">M10,2 A8,8 0 1 0 10,18 A8,8 0 1 0 10,2 M16,16 L23,23</Geometry>
        <Geometry x:Key="HomeIcon">M2,11 L12,2 L22,11 M5,9 L5,22 L10,22 L10,15 L15,15 L15,22 L20,22 L20,9</Geometry>
        <Geometry x:Key="SettingsIcon">M9,2 L15,2 L16,6 L20,6 L22,11 L19,14 L20,18 L15,22 L12,19 L8,21 L3,17 L5,13 L2,10 L5,5 L9,6 Z M12,8 A4,4 0 1 0 12,16 A4,4 0 1 0 12,8</Geometry>
        <Geometry x:Key="BellIcon">M5,16 L5,10 C5,1 19,1 19,10 L19,16 L22,19 L2,19 Z M9,22 L15,22</Geometry>
        <Geometry x:Key="ChevronIcon">M8,3 L16,12 L8,21</Geometry>
        <Geometry x:Key="DownIcon">M4,8 L12,16 L20,8</Geometry>
        <Geometry x:Key="FolderIcon">M2,6 L10,6 L12,9 L22,9 L22,21 L2,21 Z M2,6 L2,3 L9,3 L12,6 L20,6 L20,9</Geometry>
        <Geometry x:Key="GridIcon">M2,2 L9,2 L9,9 L2,9 Z M15,2 L22,2 L22,9 L15,9 Z M2,15 L9,15 L9,22 L2,22 Z M15,15 L22,15 L22,22 L15,22 Z</Geometry>
        <Geometry x:Key="ListIcon">M3,4 L21,4 M3,12 L21,12 M3,20 L21,20</Geometry>
        <Geometry x:Key="StarIcon">M12,2 L15,8 L22,9 L17,14 L18,22 L12,18 L6,22 L7,14 L2,9 L9,8 Z</Geometry>
        <Geometry x:Key="ClockIcon">M12,2 A10,10 0 1 0 12,22 A10,10 0 1 0 12,2 M12,6 L12,12 L17,15</Geometry>
        <Geometry x:Key="PeopleIcon">M9,3 A3,3 0 1 0 9,9 A3,3 0 1 0 9,3 M2,21 L2,17 C2,10 16,10 16,17 L16,21 M17,3 C23,3 23,10 17,10 M19,13 C23,13 23,18 23,21</Geometry>
        <Geometry x:Key="LayersIcon">M12,2 L23,8 L12,14 L1,8 Z M2,13 L12,19 L22,13 M2,18 L12,24 L22,18</Geometry>
        <Geometry x:Key="CloudIcon">M6,20 C-1,20 -1,10 5,9 C5,-1 20,-1 20,10 C27,10 27,20 20,20 Z</Geometry>
        <Geometry x:Key="BulbIcon">M8,18 C8,13 4,13 4,8 C4,-2 20,-2 20,8 C20,13 16,13 16,18 Z M8,21 L16,21 M10,24 L14,24 M12,8 L12,18</Geometry>

        <Style x:Key="OutlineIcon" TargetType="Path">
            <Setter Property="Width" Value="20"/><Setter Property="Height" Value="20"/>
            <Setter Property="Stretch" Value="Uniform"/><Setter Property="Stroke" Value="#213652"/>
            <Setter Property="StrokeThickness" Value="1.7"/><Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/><Setter Property="StrokeLineJoin" Value="Round"/>
        </Style>
        <Style x:Key="FlatControl" TargetType="ButtonBase">
            <Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="10,7"/>
            <Setter Property="Foreground" Value="#172238"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ButtonBase">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#EDF4FF"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="#DCEAFF"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#145ED9"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource FlatControl}"/>
        <Style TargetType="ToggleButton" BasedOn="{StaticResource FlatControl}"/>
        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource FlatControl}">
            <Setter Property="Width" Value="40"/><Setter Property="Height" Value="40"/><Setter Property="Padding" Value="10"/>
        </Style>

        <!-- Controlos da legenda ao estilo Windows: sem rebordo arredondado e com hover discreto. -->
        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#23344E"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Arrow"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CaptionSurface" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CaptionSurface" Property="Background" Value="#E8EDF5"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CaptionSurface" Property="Background" Value="#CED9E8"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="CaptionSurface" Property="BorderBrush" Value="#286DE0"/>
                                <Setter TargetName="CaptionSurface" Property="BorderThickness" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CloseCaptionButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CaptionSurface" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CaptionSurface" Property="Background" Value="#E81123"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CaptionSurface" Property="Background" Value="#B50E1C"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- O seletor de dashboard utiliza a mesma forma/paleta do campo de pesquisa. -->
        <Style x:Key="DashboardSelectorStyle" TargetType="ComboBox">
            <Setter Property="Foreground" Value="#263851"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CBD8EA"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="14,0,10,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="SelectorSurface" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="22"/>
                            <Grid Margin="{TemplateBinding Padding}" IsHitTestVisible="False">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/></Grid.ColumnDefinitions>
                                <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                                  VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <Path Grid.Column="1" Data="{StaticResource DownIcon}" Stretch="Uniform"
                                      Width="11" Height="7" Stroke="{TemplateBinding Foreground}"
                                      StrokeThickness="2" VerticalAlignment="Center"/>
                            </Grid>
                            <ToggleButton x:Name="DropdownToggle" Focusable="False"
                                          Background="Transparent" BorderThickness="0"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent"/>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup" Placement="Bottom" PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                   IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" StaysOpen="False">
                                <Border Background="{Binding Background, RelativeSource={RelativeSource TemplatedParent}}"
                                        BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource TemplatedParent}}"
                                        BorderThickness="1" CornerRadius="10" Padding="6"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SelectorSurface" Property="BorderBrush" Value="#4C89D9"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="SelectorSurface" Property="BorderBrush" Value="#286DE0"/>
                                <Setter TargetName="SelectorSurface" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="HeaderActionButton" TargetType="Button" BasedOn="{StaticResource FlatControl}">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="BorderBrush" Value="#E0E8F3"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#F7FAFF"/>
        </Style>
        <Geometry x:Key="MaximizeGlyph">M2,2 L14,2 L14,14 L2,14 Z</Geometry>
        <Geometry x:Key="RestoreGlyph">M4,1 L14,1 L14,11 M4,4 L1,4 L1,15 L12,15 L12,4 Z</Geometry>
        <Style x:Key="NavigationButton" TargetType="Button" BasedOn="{StaticResource FlatControl}">
            <Setter Property="Height" Value="39"/><Setter Property="Padding" Value="12,4"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Margin" Value="0,1"/>
        </Style>
        <Style x:Key="CreationCard" TargetType="Button" BasedOn="{StaticResource FlatControl}">
            <Setter Property="Height" Value="120"/><Setter Property="Padding" Value="6,10"/>
            <Setter Property="Margin" Value="0,0,10,12"/><Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#DDE4EF"/>
        </Style>
        <Style x:Key="FilterButton" TargetType="RadioButton" BasedOn="{StaticResource FlatControl}">
            <Setter Property="FontSize" Value="12"/><Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="2,0"/>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="#E2EDFF"/><Setter Property="Foreground" Value="#114CB3"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#DDE4EF"/>
            <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="12"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22"/><Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Foreground" Value="#101828"/>
        </Style>
        <DataTemplate x:Key="ApplicationIcon">
            <Border Width="40" Height="40" CornerRadius="9" Background="{Binding Color}">
                <Grid>
                    <Border CornerRadius="9">
                        <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#30FFFFFF"/><GradientStop Color="#00000000" Offset="0.7"/><GradientStop Color="#18000000" Offset="1"/></LinearGradientBrush></Border.Background>
                    </Border>
                    <Path Data="{Binding Icon}" Width="25" Height="25" Stretch="Uniform" Stroke="White" StrokeThickness="1.7"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                    <TextBlock Text="{Binding Symbol}" Foreground="White" FontSize="27" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"/>
                </Grid>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="ApplicationNavigation">
            <Button Style="{StaticResource NavigationButton}" AutomationProperties.Name="{Binding Name}">
                <StackPanel Orientation="Horizontal">
                    <Viewbox Width="28" Height="28"><ContentControl Content="{Binding}" ContentTemplate="{StaticResource ApplicationIcon}"/></Viewbox>
                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Margin="16,0,0,0"/>
                </StackPanel>
            </Button>
        </DataTemplate>
    </Window.Resources>

    <Border x:Name="HomeRoot" Background="#FAFBFD" BorderBrush="#DCE3ED" BorderThickness="1">
        <Grid KeyboardNavigation.TabNavigation="Cycle">
            <Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="*"/></Grid.RowDefinitions>

            <!-- Cabeçalho: identidade, pesquisa e controlos da aplicação. -->
            <Border Background="#FDFEFF" BorderBrush="{StaticResource HomeLine}" BorderThickness="0,0,0,1">
                <Grid Margin="20,0,4,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Background="Transparent" Margin="0,0,26,0">
                        <Viewbox Width="38" Height="36" Margin="0,0,10,0">
                            <Canvas Width="40" Height="36">
                                <Path Data="M3,3 C-1,3 -1,8 1,12 L13,33 C15,37 23,37 25,32 L39,9 C43,1 31,-3 27,4 L19,18 L11,4 C9,1 5,1 3,3 Z" Fill="#0660D5"/>
                                <Path Data="M27,4 C31,-3 43,1 39,9 L25,32 C21,39 12,34 16,27 Z" Fill="#00ADBD"/>
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="VCC Office" FontSize="23" FontWeight="Bold" VerticalAlignment="Center" Foreground="#0B1220"/>
                        <StackPanel x:Name="BrandSubtitle" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="1" Height="24" Background="#CDD6E5" Margin="24,0"/>
                            <TextBlock Text="Suite de Produtividade" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                    <Border shell:WindowChrome.IsHitTestVisibleInChrome="True" Grid.Column="1" CornerRadius="22" BorderBrush="#CCD6E6" BorderThickness="1" Background="White" Height="42" VerticalAlignment="Center" Margin="0,0,210,0">
                        <Grid Margin="17,0,10,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="56"/></Grid.ColumnDefinitions>
                            <Path Data="{StaticResource SearchIcon}" Style="{StaticResource OutlineIcon}" Width="18" Height="18"/>
                            <Grid Grid.Column="1" Margin="10,0,6,0">
                                <TextBox x:Name="GlobalSearchBox" VerticalContentAlignment="Center" BorderThickness="0" Background="Transparent" FontSize="13"
                                         AutomationProperties.Name="Pesquisar ficheiros, modelos, aplicações e funcionalidades" ToolTip="Pesquisar (Ctrl+K)"/>
                                <TextBlock Text="Pesquisar ficheiros, modelos, aplicações e funcionalidades..." FontSize="13" Foreground="#667188" VerticalAlignment="Center" IsHitTestVisible="False" TextTrimming="CharacterEllipsis">
                                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=GlobalSearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                </TextBlock>
                            </Grid>
                            <Border Grid.Column="2" Background="#F2F5F9" CornerRadius="5" Padding="6,3" VerticalAlignment="Center">
                                <TextBlock Text="Ctrl + K" FontSize="11" HorizontalAlignment="Center" Foreground="#58657A"/>
                            </Border>
                        </Grid>
                    </Border>
                    <ComboBox x:Name="DashboardSelector" Grid.Column="1" Width="180" Height="42" Style="{StaticResource DashboardSelectorStyle}" shell:WindowChrome.IsHitTestVisibleInChrome="True"
                              HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0"
                              DisplayMemberPath="Name" SelectedValuePath="Id"
                              SelectionChanged="DashboardSelector_SelectionChanged"
                              ToolTip="Selecionar dashboard" AutomationProperties.Name="Selecionar dashboard"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button x:Name="NotificationsButton" Style="{StaticResource HeaderActionButton}" ToolTip="Notificações"
                                AutomationProperties.Name="Notificações" Click="Notifications_Click">
                            <Grid Width="20" Height="20">
                                <Path Data="{StaticResource BellIcon}" Stroke="#264567" StrokeThickness="1.7"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="Uniform"/>
                            </Grid>
                        </Button>
                        <Button x:Name="SettingsButton" Style="{StaticResource HeaderActionButton}" Margin="3,0,12,0"
                                ToolTip="Definições do VCC Office" AutomationProperties.Name="Definições da aplicação"
                                Click="OpenDashboardSettings_Click">
                            <Path Data="{StaticResource SettingsIcon}" Stroke="#264567" StrokeThickness="1.7"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Width="21" Height="21" Stretch="Uniform"/>
                        </Button>
                        <Button Padding="4,5" AutomationProperties.Name="Conta do utilizador" ToolTip="Conta do utilizador">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="34" Height="34" CornerRadius="17" Background="#E0EAF9"><TextBlock Text="U" FontSize="16" FontWeight="SemiBold" Foreground="#285C9B" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                <TextBlock x:Name="UserLabel" Text="Utilizador" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" Margin="10,0"/>
                                <Path Data="{StaticResource DownIcon}" Style="{StaticResource OutlineIcon}" Width="10" Height="10" Margin="6,0"/>
                            </StackPanel>
                        </Button>
                        <Border Width="1" Height="24" Background="#D8E1EE" Margin="8,0,4,0"/>
                        <Button Style="{StaticResource CaptionButton}" Click="Minimize_Click" ToolTip="Minimizar" AutomationProperties.Name="Minimizar janela">
                            <Path Data="M1,8 L15,8" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.5" Width="16" Height="16" Stretch="Uniform"/>
                        </Button>
                        <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Click="Maximize_Click"
                                ToolTip="Maximizar" AutomationProperties.Name="Maximizar ou restaurar janela">
                            <Path x:Name="MaximizeIcon" Data="{StaticResource MaximizeGlyph}"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.4" StrokeLineJoin="Miter" Width="15" Height="15" Stretch="Uniform"/>
                        </Button>
                        <Button Style="{StaticResource CloseCaptionButton}" Click="Close_Click" ToolTip="Fechar"
                                AutomationProperties.Name="Fechar janela">
                            <Path Data="M2,2 L14,14 M14,2 L2,14"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.5" Width="16" Height="16" Stretch="Uniform"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid x:Name="ClassicDashboardRoot" Grid.Row="1">
                <Grid.ColumnDefinitions><ColumnDefinition Width="228"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <!-- Navegação lateral. Os módulos ficam por ligar nesta fase. -->
                <Border BorderBrush="{StaticResource HomeLine}" BorderThickness="0,0,1,0">
                    <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#F1F5FC"/><GradientStop Color="#F8FAFE" Offset="1"/></LinearGradientBrush></Border.Background>
                    <Grid Margin="10,12,10,12">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <StackPanel>
                            <Button Style="{StaticResource NavigationButton}" Height="44" Background="#DDEBFF" Foreground="#103C88" AutomationProperties.Name="Início" AutomationProperties.ItemStatus="Selecionado">
                                <StackPanel Orientation="Horizontal"><Path Data="{StaticResource HomeIcon}" Style="{StaticResource OutlineIcon}" Fill="#123F8C" Stroke="#123F8C" Width="23" Height="23" Margin="0,0,16,0"/><TextBlock Text="Início" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
                            </Button>
                            <Grid Margin="13,16,8,8"><TextBlock Text="Aplicações" FontWeight="SemiBold"/><Path Data="M3,12 L9,6 L15,12" Style="{StaticResource OutlineIcon}" Width="13" Height="13" HorizontalAlignment="Right"/></Grid>
                        </StackPanel>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
                            <StackPanel>
                                <ItemsControl x:Name="SidebarApplications" ItemsSource="{Binding MainApplications}" ItemTemplate="{StaticResource ApplicationNavigation}"/>
                                <ToggleButton x:Name="MoreApplicationsButton" Height="44" Padding="12,6" HorizontalContentAlignment="Left" AutomationProperties.Name="Mais aplicações" Margin="0,3,0,8">
                                    <Grid Width="178"><Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/></Grid.ColumnDefinitions>
                                        <Path Data="M2,2 L4,2 M10,2 L12,2 M18,2 L20,2 M2,10 L4,10 M10,10 L12,10 M18,10 L20,10 M2,18 L4,18 M10,18 L12,18 M18,18 L20,18" Style="{StaticResource OutlineIcon}" StrokeThickness="3"/>
                                        <TextBlock Grid.Column="1" Text="Mais aplicações" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                        <Path Grid.Column="2" Data="{StaticResource ChevronIcon}" Style="{StaticResource OutlineIcon}" Width="8" Height="12"/>
                                    </Grid>
                                </ToggleButton>
                            </StackPanel>
                        </ScrollViewer>
                        <Border Grid.Row="2" BorderBrush="#D7DFEB" BorderThickness="0,1,0,0" Padding="0,10,0,0" Margin="12,0">
                            <Button HorizontalContentAlignment="Left" AutomationProperties.Name="Definições" Padding="0,8" Click="OpenDashboardSettings_Click">
                                <StackPanel Orientation="Horizontal"><Path Data="{StaticResource SettingsIcon}" Style="{StaticResource OutlineIcon}" Margin="0,0,16,0"/><TextBlock Text="Definições" VerticalAlignment="Center"/></StackPanel>
                            </Button>
                        </Border>
                    </Grid>
                </Border>

                <ScrollViewer x:Name="HomeContentScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
                    <Grid Margin="22,18,22,24">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition x:Name="RightColumn" Width="282"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <!-- Banner inteiramente vetorial, sem dependência de rede. -->
                            <Border x:Name="WelcomeBanner" Height="145" CornerRadius="14" ClipToBounds="True">
                                <Border.Background><LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5"><GradientStop Color="#1D54D9"/><GradientStop Color="#067DD5" Offset="0.58"/><GradientStop Color="#00B4AD" Offset="1"/></LinearGradientBrush></Border.Background>
                                <Grid ClipToBounds="True">
                                    <Path Data="M0,145 C350,140 300,60 650,105 C850,130 900,45 1200,40 L1200,180 L0,180 Z" Fill="#1666BD" Opacity="0.28" Stretch="Fill"/>
                                    <Path Data="M0,145 C370,145 470,50 720,70 C950,110 1050,25 1200,0 L1200,145 Z" Fill="#12C0D1" Opacity="0.15" Stretch="Fill"/>
                                    <StackPanel VerticalAlignment="Center" Margin="32,0,0,0">
                                        <TextBlock Text="Bem-vindo ao VCC Office" Foreground="White" FontWeight="Bold" FontSize="31"/>
                                        <TextBlock Text="A sua suite completa de produtividade" Foreground="#F5FAFF" FontSize="18" Margin="0,7,0,0"/>
                                    </StackPanel>
                                    <Canvas x:Name="BannerArtwork" Width="290" Height="145" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,10,0" IsHitTestVisible="False">
                                        <Border Width="82" Height="116" Canvas.Left="105" Canvas.Top="31" CornerRadius="8" Background="#F8FFFE" RenderTransformOrigin="0.5,0.5"><Border.RenderTransform><RotateTransform Angle="6"/></Border.RenderTransform><StackPanel Margin="10"><Border Height="28" Background="#14A665" CornerRadius="4"><TextBlock Text="S" Foreground="White" FontSize="23" FontWeight="Bold" Margin="6,0"/></Border><UniformGrid Columns="3" Rows="4" Height="54" Margin="0,9,0,0"><Border Background="#ADE1CD" Margin="1"/><Border Background="#D9F1E6" Margin="1"/><Border Background="#B8E6D6" Margin="1"/><Border Background="#D9F1E6" Margin="1"/><Border Background="#B8E6D6" Margin="1"/><Border Background="#D9F1E6" Margin="1"/><Border Background="#B8E6D6" Margin="1"/><Border Background="#D9F1E6" Margin="1"/><Border Background="#B8E6D6" Margin="1"/><Border Background="#D9F1E6" Margin="1"/><Border Background="#B8E6D6" Margin="1"/><Border Background="#D9F1E6" Margin="1"/></UniformGrid></StackPanel></Border>
                                        <Border Width="82" Height="112" Canvas.Left="167" Canvas.Top="57" CornerRadius="8" Background="#FFFEFD" RenderTransformOrigin="0.5,0.5"><Border.RenderTransform><RotateTransform Angle="10"/></Border.RenderTransform><StackPanel Margin="10"><Border Height="25" Background="#EF8A12" CornerRadius="4"/><Ellipse Width="37" Height="37" Fill="#F4AF4C" Margin="0,8,0,6"/><Border Height="4" Background="#C5D7EB"/><Border Height="4" Background="#D8E3F0" Margin="0,6,10,0"/></StackPanel></Border>
                                        <Border Width="82" Height="107" Canvas.Left="223" Canvas.Top="78" CornerRadius="8" Background="#F1F7FF" RenderTransformOrigin="0.5,0.5"><Border.RenderTransform><RotateTransform Angle="12"/></Border.RenderTransform><StackPanel Margin="10"><Border Height="23" Background="#4D85E8" CornerRadius="4"/><TextBlock Text="✓ ━━" Foreground="#357AE1" FontSize="19" Margin="0,7,0,0"/><TextBlock Text="✓ ━━" Foreground="#357AE1" FontSize="19"/></StackPanel></Border>
                                        <Border Width="82" Height="114" Canvas.Left="44" Canvas.Top="68" CornerRadius="8" Background="#F5FBFF" RenderTransformOrigin="0.5,0.5"><Border.RenderTransform><RotateTransform Angle="-10"/></Border.RenderTransform><StackPanel Margin="10"><Border Width="31" Height="31" CornerRadius="5" Background="#1478E8" HorizontalAlignment="Left"><TextBlock Text="W" FontSize="23" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/></Border><Border Height="5" Background="#7BB0EA" Margin="0,10,0,0"/><Border Height="4" Background="#B8D7F1" Margin="0,7,4,0"/><Border Height="4" Background="#B8D7F1" Margin="0,7,0,0"/><Border Height="4" Background="#B8D7F1" Margin="0,7,12,0"/></StackPanel></Border>
                                    </Canvas>
                                </Grid>
                            </Border>

                            <DockPanel Margin="7,23,0,14">
                                <Button DockPanel.Dock="Right" HorizontalAlignment="Right" Padding="5,6" Foreground="#173F87" AutomationProperties.Name="Modelos">
                                    <StackPanel Orientation="Horizontal"><Path Data="{StaticResource GridIcon}" Style="{StaticResource OutlineIcon}" Width="15" Height="15"/><TextBlock Text="Modelos" FontSize="13" FontWeight="SemiBold" Margin="8,0,10,0"/><Path Data="{StaticResource ChevronIcon}" Style="{StaticResource OutlineIcon}" Width="7" Height="11"/></StackPanel>
                                </Button>
                                <TextBlock Text="Criar novo" Style="{StaticResource SectionTitle}"/>
                            </DockPanel>
                            <ItemsControl x:Name="CreationItems" ItemsSource="{Binding CreationActions}" Margin="7,0,-3,0">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="6"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource CreationCard}" AutomationProperties.Name="{Binding Title}">
                                            <StackPanel HorizontalAlignment="Center">
                                                <ContentControl Content="{Binding Application}" ContentTemplate="{StaticResource ApplicationIcon}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                                <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding Application.Name}" FontSize="12" Foreground="#5D6A80" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Border BorderBrush="{StaticResource HomeLine}" BorderThickness="0,1,0,0" Margin="7,4,0,0" Padding="0,20,0,0">
                                <StackPanel>
                                    <TextBlock Text="Ficheiros recentes" Style="{StaticResource SectionTitle}" Margin="0,0,0,12"/>
                                    <DockPanel Margin="0,0,0,16">
                                        <Border DockPanel.Dock="Right" Style="{StaticResource Panel}" CornerRadius="8" HorizontalAlignment="Right" Margin="8,0,0,0">
                                            <StackPanel Orientation="Horizontal">
                                                <RadioButton x:Name="ListModeButton" GroupName="RecentViewMode" Style="{StaticResource FilterButton}" IsChecked="True" Padding="9,7" Margin="0" ToolTip="Vista de lista" AutomationProperties.Name="Vista de lista"><Path Data="{StaticResource ListIcon}" Style="{StaticResource OutlineIcon}" Width="17" Height="17"/></RadioButton>
                                                <RadioButton GroupName="RecentViewMode" Style="{StaticResource FilterButton}" Padding="9,7" Margin="0" ToolTip="Vista de grelha" AutomationProperties.Name="Vista de grelha"><Path Data="{StaticResource GridIcon}" Style="{StaticResource OutlineIcon}" Width="17" Height="17"/></RadioButton>
                                            </StackPanel>
                                        </Border>
                                        <WrapPanel VerticalAlignment="Center">
                                            <RadioButton GroupName="RecentFilter" Content="Todos" Style="{StaticResource FilterButton}" IsChecked="True" AutomationProperties.Name="Todos os ficheiros recentes"/>
                                            <RadioButton GroupName="RecentFilter" Content="Documentos" Style="{StaticResource FilterButton}"/>
                                            <RadioButton GroupName="RecentFilter" Content="Folhas de cálculo" Style="{StaticResource FilterButton}"/>
                                            <RadioButton GroupName="RecentFilter" Content="Apresentações" Style="{StaticResource FilterButton}"/>
                                            <RadioButton GroupName="RecentFilter" Content="PDF" Style="{StaticResource FilterButton}"/>
                                        </WrapPanel>
                                    </DockPanel>
                                    <Grid Margin="4,0,4,0">
                                        <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsChecked, ElementName=ListModeButton}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Grid.Style>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="2.5*"/><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="0.7*"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Nome" FontSize="12" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Column="1" Text="Aplicação" FontSize="12" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Column="2" Text="Modificado em ↓" FontSize="12" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Column="3" Text="Tamanho" FontSize="12" FontWeight="SemiBold"/>
                                    </Grid>
                                    <Border BorderBrush="{StaticResource HomeLine}" BorderThickness="0,1,0,1" Margin="0,12,0,0" Padding="15,28,15,30">
                                        <StackPanel HorizontalAlignment="Center">
                                            <Border Width="52" Height="48" CornerRadius="13" Background="#EEF4FE" Margin="0,0,0,12"><Path Data="{StaticResource FolderIcon}" Style="{StaticResource OutlineIcon}" Stroke="#7B9CCD" Width="27" Height="27"/></Border>
                                            <TextBlock Text="Ainda não há ficheiros recentes" FontWeight="SemiBold" FontSize="14" TextAlignment="Center"/>
                                            <TextBlock Text="Os ficheiros que abrir aparecerão aqui." FontSize="12" Foreground="{StaticResource HomeMuted}" TextAlignment="Center" Margin="0,5,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Painéis laterais. -->
                        <StackPanel Grid.Column="2">
                            <Border Style="{StaticResource Panel}">
                                <StackPanel>
                                    <Border Background="#F5F8FD" CornerRadius="12,12,0,0" Padding="17,17">
                                        <StackPanel Orientation="Horizontal"><Path Data="{StaticResource LayersIcon}" Style="{StaticResource OutlineIcon}" Stroke="#1757C2" Width="22" Height="22" Margin="0,0,10,0"/><TextBlock Text="O meu espaço de trabalho" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center"/></StackPanel>
                                    </Border>
                                    <StackPanel Margin="8,0,8,5">
                                        <Button Height="51" HorizontalContentAlignment="Stretch" AutomationProperties.Name="Os meus ficheiros"><DockPanel><Path DockPanel.Dock="Right" Data="{StaticResource ChevronIcon}" Style="{StaticResource OutlineIcon}" Width="7" Height="12"/><Path DockPanel.Dock="Left" Data="{StaticResource FolderIcon}" Style="{StaticResource OutlineIcon}" Margin="0,0,14,0"/><TextBlock Text="Os meus ficheiros" VerticalAlignment="Center"/></DockPanel></Button>
                                        <Border Height="1" Background="#EDF0F5" Margin="10,0"/>
                                        <Button Height="51" HorizontalContentAlignment="Stretch" AutomationProperties.Name="Projetos"><DockPanel><Path DockPanel.Dock="Right" Data="{StaticResource ChevronIcon}" Style="{StaticResource OutlineIcon}" Width="7" Height="12"/><Path DockPanel.Dock="Left" Data="{StaticResource PeopleIcon}" Style="{StaticResource OutlineIcon}" Margin="0,0,14,0"/><TextBlock Text="Projetos" VerticalAlignment="Center"/></DockPanel></Button>
                                        <Border Height="1" Background="#EDF0F5" Margin="10,0"/>
                                        <Button Height="51" HorizontalContentAlignment="Stretch" AutomationProperties.Name="Modelos do espaço de trabalho"><DockPanel><Path DockPanel.Dock="Right" Data="{StaticResource ChevronIcon}" Style="{StaticResource OutlineIcon}" Width="7" Height="12"/><Path DockPanel.Dock="Left" Data="{StaticResource GridIcon}" Style="{StaticResource OutlineIcon}" Margin="0,0,14,0"/><TextBlock Text="Modelos" VerticalAlignment="Center"/></DockPanel></Button>
                                        <Border Height="1" Background="#EDF0F5" Margin="10,0"/>
                                        <Button Height="51" HorizontalContentAlignment="Stretch" AutomationProperties.Name="Favoritos"><DockPanel><Path DockPanel.Dock="Right" Data="{StaticResource ChevronIcon}" Style="{StaticResource OutlineIcon}" Width="7" Height="12"/><Path DockPanel.Dock="Left" Data="{StaticResource StarIcon}" Style="{StaticResource OutlineIcon}" Margin="0,0,14,0"/><TextBlock Text="Favoritos" VerticalAlignment="Center"/></DockPanel></Button>
                                        <Border Height="1" Background="#EDF0F5" Margin="10,0"/>
                                        <Button Height="51" HorizontalContentAlignment="Stretch" AutomationProperties.Name="Partilhados comigo"><DockPanel><Path DockPanel.Dock="Right" Data="{StaticResource ChevronIcon}" Style="{StaticResource OutlineIcon}" Width="7" Height="12"/><Path DockPanel.Dock="Left" Data="{StaticResource ClockIcon}" Style="{StaticResource OutlineIcon}" Margin="0,0,14,0"/><TextBlock Text="Partilhados comigo" VerticalAlignment="Center"/></DockPanel></Button>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Panel}" Margin="0,22,0,0" Padding="18,18,18,17">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal"><Path Data="{StaticResource CloudIcon}" Style="{StaticResource OutlineIcon}" Stroke="#145ED9" Width="23" Height="23" Margin="0,0,10,0"/><TextBlock Text="Armazenamento local" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
                                    <ProgressBar Minimum="0" Maximum="100" Value="{Binding StoragePercent, Mode=OneWay}" Height="10" Margin="0,17,0,12" Foreground="#1466DC" Background="#E6ECF5" BorderThickness="0" AutomationProperties.Name="Utilização do armazenamento local">
                                        <ProgressBar.Template><ControlTemplate TargetType="ProgressBar"><Grid ClipToBounds="True"><Border Background="{TemplateBinding Background}" CornerRadius="5"/><Border x:Name="PART_Track"/><Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="5" HorizontalAlignment="Left"/></Grid></ControlTemplate></ProgressBar.Template>
                                    </ProgressBar>
                                    <TextBlock Text="{Binding StorageDescription}" FontSize="13" FontWeight="SemiBold" Foreground="#164EA4"/>
                                    <TextBlock Text="{Binding StoragePercentage}" FontSize="11" Foreground="{StaticResource HomeMuted}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#EFFAF5" BorderBrush="#D1EDDE" BorderThickness="1" CornerRadius="12" Margin="0,22,0,0" Padding="18,19">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal"><Path Data="{StaticResource BulbIcon}" Style="{StaticResource OutlineIcon}" Stroke="#27985B" Width="23" Height="27" Margin="0,0,10,0"/><TextBlock Text="Dica do VCC Office" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center"/></StackPanel>
                                    <TextBlock Text="Utilize modelos prontos para criar documentos, apresentações, planos de projeto e muito mais." TextWrapping="Wrap" FontSize="14" LineHeight="21" Margin="0,13,0,13"/>
                                    <Button Foreground="#1754B3" Padding="0,4" HorizontalAlignment="Left" AutomationProperties.Name="Explorar modelos"><StackPanel Orientation="Horizontal"><TextBlock Text="Explorar modelos" FontSize="14" FontWeight="SemiBold"/><TextBlock Text="→" FontSize="23" Margin="10,-6,0,0"/></StackPanel></Button>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Grid>

            <ContentControl x:Name="AlternativeDashboardHost" Grid.Row="1" Visibility="Collapsed"/>
            <Popup x:Name="MoreApplicationsPopup" PlacementTarget="{Binding ElementName=MoreApplicationsButton}" Placement="Right" HorizontalOffset="12"
                   IsOpen="{Binding IsChecked, ElementName=MoreApplicationsButton, Mode=TwoWay}" StaysOpen="False" AllowsTransparency="True" PopupAnimation="None" Opened="MoreApplicationsPopup_Opened">
                <Border Style="{StaticResource Panel}" Padding="14" Width="390" BorderBrush="#CCD8E9" KeyboardNavigation.TabNavigation="Cycle">
                    <StackPanel>
                        <TextBlock Text="Mais aplicações" FontSize="18" FontWeight="SemiBold" Margin="8,4,0,12"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="450" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="AdditionalApplications" ItemsSource="{Binding MoreApplications}" ItemTemplate="{StaticResource ApplicationNavigation}"/>
                        </ScrollViewer>
                    </StackPanel>
                </Border>
            </Popup>
        </Grid>
    </Border>
</Window>
