<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Headless" Version="12.1.6" />
    <ProjectReference Include="../../src/Vcc.Office.Desktop/Vcc.Office.Desktop.csproj" />
    <ProjectReference Include="../../src/Vcc.Office.Writer/Vcc.Office.Writer.csproj" />
    <ProjectReference Include="../../src/Vcc.Office.Sheets/Vcc.Office.Sheets.csproj" />
    <ProjectReference Include="../../src/Vcc.Office.Slides/Vcc.Office.Slides.csproj" />
    <ProjectReference Include="../../src/Vcc.Office.Data/Vcc.Office.Data.csproj" />
    <ProjectReference Include="../../src/Vcc.Office.PluginHost/Vcc.Office.PluginHost.csproj" />
  </ItemGroup>
  <!-- The smoke runner has its own BaseDirectory; stage the same plugin as the actual launcher. -->
  <Target Name="StageWriterPluginForSmoke" AfterTargets="Build">
    <MakeDir Directories="$(TargetDir)Plugins/Writer" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)/../../src/Vcc.Office.Writer/bin/$(Configuration)/net10.0/Vcc.Office.Writer.dll" DestinationFolder="$(TargetDir)Plugins/Writer" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)/../../src/Vcc.Office.Writer/plugin.json" DestinationFolder="$(TargetDir)Plugins/Writer" />
    <MakeDir Directories="$(TargetDir)Plugins/Sheets" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)/../../src/Vcc.Office.Sheets/bin/$(Configuration)/net10.0/Vcc.Office.Sheets.dll" DestinationFolder="$(TargetDir)Plugins/Sheets" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)/../../src/Vcc.Office.Sheets/plugin.json" DestinationFolder="$(TargetDir)Plugins/Sheets" />
    <MakeDir Directories="$(TargetDir)Plugins/Slides" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)/../../src/Vcc.Office.Slides/bin/$(Configuration)/net10.0/Vcc.Office.Slides.dll" DestinationFolder="$(TargetDir)Plugins/Slides" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)/../../src/Vcc.Office.Slides/plugin.json" DestinationFolder="$(TargetDir)Plugins/Slides" />
    <MakeDir Directories="$(TargetDir)Plugins/Data" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)/../../src/Vcc.Office.Data/bin/$(Configuration)/net10.0/Vcc.Office.Data.dll" DestinationFolder="$(TargetDir)Plugins/Data" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)/../../src/Vcc.Office.Data/plugin.json" DestinationFolder="$(TargetDir)Plugins/Data" />
  </Target>
</Project>